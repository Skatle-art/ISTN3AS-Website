<%@ Page Title="Services - Hlangalezwe Dental Clinic" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Services.aspx.cs" Inherits="Hlangalezwe_Dental_Clinic.WebForm1" %>

<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">

    <!-- SERVICES PAGE -->
    <section class="services-page py-5" style="background-color: #f4f7f9;">
        <div class="container">
            <h1 class="text-center mb-5" style="color: #0097a7; font-weight: 700;">Our Services</h1>

            <div class="row g-4">
                <!-- Braces Installation -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🦷</div>
                            <h5 class="card-title mb-2">Braces Installation</h5>
                            <p class="card-text">Composite resin brackets, fixed dental braces, clear aligner treatment.</p>
                            <p><b>Cost:</b> R 12,000 | <b>Duration:</b> 120 min</p>
                        </div>
                    </div>
                </div>

                <!-- Teeth Cleaning -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🪥</div>
                            <h5 class="card-title mb-2">Teeth Cleaning</h5>
                            <p class="card-text">Standard dental cleaning to keep your smile healthy.</p>
                            <p><b>Cost:</b> R 100 | <b>Duration:</b> 45 min</p>
                        </div>
                    </div>
                </div>

                <!-- Root Canal -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🦷</div>
                            <h5 class="card-title mb-2">Root Canal</h5>
                            <p class="card-text">Endodontic treatment, Molar root canal.</p>
                            <p><b>Cost:</b> R 750 – R 850 | <b>Duration:</b> 90 min</p>
                        </div>
                    </div>
                </div>

                <!-- Crown -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🦷</div>
                            <h5 class="card-title mb-2">Crown</h5>
                            <p class="card-text">Porcelain crown, Gold crown.</p>
                            <p><b>Cost:</b> R 800 – R 900 | <b>Duration:</b> 60 – 90 min</p>
                        </div>
                    </div>
                </div>

                <!-- Extraction -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🪥</div>
                            <h5 class="card-title mb-2">Extraction</h5>
                            <p class="card-text">Simple tooth extraction, Wisdom tooth extraction.</p>
                            <p><b>Cost:</b> R 350 | <b>Duration:</b> 45 min</p>
                        </div>
                    </div>
                </div>

                <!-- Whitening -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">😁</div>
                            <h5 class="card-title mb-2">Whitening</h5>
                            <p class="card-text">In-office and take-home whitening treatments.</p>
                            <p><b>Cost:</b> R 300 | <b>Duration:</b> 15 – 60 min</p>
                        </div>
                    </div>
                </div>

                <!-- Implant -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🦷</div>
                            <h5 class="card-title mb-2">Implant</h5>
                            <p class="card-text">Dental implant, Implant crown.</p>
                            <p><b>Cost:</b> R 1,500 – R 2,500 | <b>Duration:</b> 60 – 90 min</p>
                        </div>
                    </div>
                </div>

                <!-- Bridge -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🦷</div>
                            <h5 class="card-title mb-2">Bridge</h5>
                            <p class="card-text">Porcelain-fused bridge to replace missing teeth.</p>
                            <p><b>Cost:</b> R 1,100 | <b>Duration:</b> 90 min</p>
                        </div>
                    </div>
                </div>

                <!-- Veneers -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">😁</div>
                            <h5 class="card-title mb-2">Veneers</h5>
                            <p class="card-text">Porcelain and composite veneers for a perfect smile.</p>
                            <p><b>Cost:</b> R 60 – R 600 | <b>Duration:</b> 60 min</p>
                        </div>
                    </div>
                </div>

                <!-- Bonding -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">😁</div>
                            <h5 class="card-title mb-2">Bonding</h5>
                            <p class="card-text">Front tooth bonding for minor repairs and aesthetics.</p>
                            <p><b>Cost:</b> R 300 | <b>Duration:</b> 60 min</p>
                        </div>
                    </div>
                </div>

                <!-- Scaling -->
                <div class="col-md-4">
                    <div class="card service-card h-100 shadow-sm border-0 text-center">
                        <div class="card-body">
                            <div class="service-icon mb-3" style="font-size: 50px; color: #00bcd4;">🪥</div>
                            <h5 class="card-title mb-2">Scaling</h5>
                            <p class="card-text">Periodontal maintenance for gum health.</p>
                            <p><b>Cost:</b> R 200 | <b>Duration:</b> 45 min</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <style>
        .service-card {
            transition: transform 0.3s, box-shadow 0.3s;
            border-radius: 12px;
        }
        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }
        .service-icon {
            transition: transform 0.3s;
        }
        .service-card:hover .service-icon {
            transform: scale(1.2);
        }
        .card-title {
            color: #0097a7;
            font-weight: 600;
        }
    </style>

</asp:Content>

